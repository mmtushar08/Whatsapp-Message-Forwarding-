# --- Core ---
NODE_ENV=development
PORT=3000
# In production this MUST be the exact dashboard origin (e.g. https://your-app.vercel.app).
# The server refuses to start in production if left unset.
CORS_ORIGIN=http://localhost:4173
# Public URL of THIS backend — used to generate per-workspace webhook URLs
# shown to users (e.g. https://whatsapp-forwarder.onrender.com)
PUBLIC_APP_URL=http://localhost:3000
# Number of reverse proxies in front of the app (Render/Railway/nginx = 1).
# Set to 0 when running directly with no proxy.
TRUST_PROXY=1

# --- Secrets (required) ---
# AES-256-GCM key for encrypting WhatsApp tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this later makes stored tokens unreadable.
APP_ENCRYPTION_KEY=replace_with_a_long_random_secret
# Verify token for the app-level webhook (Meta app > WhatsApp > Configuration).
# Customers who connect their own Meta app get a per-workspace token instead.
WEBHOOK_VERIFY_TOKEN=replace_with_a_long_random_secret
# Bearer token for the admin /config endpoints
ADMIN_TOKEN=replace_with_a_long_random_secret

# --- Meta app (required for "Connect with Meta" / Embedded Signup) ---
# From developers.facebook.com > your app > App settings > Basic.
# META_APP_SECRET is used server-side only: to exchange Embedded Signup codes
# and to verify webhook signatures. In production, webhooks are rejected if
# neither META_APP_SECRET nor WHATSAPP_APP_SECRET is set.
META_APP_ID=
META_APP_SECRET=
# Graph API version for every Meta call (default v25.0)
META_GRAPH_API_VERSION=v25.0
# Only for local testing against a mock Graph API:
# META_GRAPH_API_BASE_URL=http://localhost:4010

# --- Storage & logging ---
# Relative paths resolve from the process working directory.
# On Render with a disk mounted at /var/data use: /var/data/forwarder.db
DB_PATH=data/forwarder.db
SESSION_TTL_HOURS=24
LOG_LEVEL=info

# --- WhatsApp Cloud API (legacy single-tenant mode; multi-tenant workspaces
# --- store these per user via embedded signup instead). Inbound messages are
# --- only forwarded with these when they arrive for WHATSAPP_PHONE_NUMBER_ID. ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret from Meta App Settings > Basic — enables webhook signature
# verification. Strongly recommended in production.
WHATSAPP_APP_SECRET=
FORWARD_TO_NUMBER=
FORWARD_TO_NUMBERS=
KEYWORD_FILTERS=

# --- WhatsApp API tuning (optional) ---
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
WHATSAPP_TIMEOUT_MS=10000

# --- Email forwarding via SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Razorpay billing (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_BUSINESS=
